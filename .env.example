# 运行环境：development / production（部署时必须改为 production）
NODE_ENV=development

# 数据库连接
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 生产环境必须修改为强口令，禁止使用 123456
DB_PASSWORD=123456
DB_NAME=youth_league

# 后端监听端口
PORT=3000

# JWT 签名密钥：生产环境必须改为不少于 32 字节的随机字符串
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please_change_me_to_a_random_secret_of_at_least_32_bytes

# 允许跨域来源
CORS_ORIGIN=http://localhost:3000

# 上传文件大小上限（字节），默认 10MB
MAX_FILE_SIZE=10485760
